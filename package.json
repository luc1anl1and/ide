{
  "name": "hyper-ide",
  "productName": "hyper-ide",
  "version": "0.9.0",
  "description": "hyper-ide - a desktop IDE for CLI coding agents (Claude Code, Codex, OpenCode and custom agents) with an editor, real terminal, browser preview and local voice input.",
  "author": "hyper-ide contributors",
  "license": "MIT",
  "private": true,
  "main": "src/main.js",
  "homepage": "https://github.com/luc1anl1and/ide#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luc1anl1and/ide.git"
  },
  "bugs": {
    "url": "https://github.com/luc1anl1and/ide/issues"
  },
  "keywords": [
    "ide",
    "electron",
    "claude-code",
    "codex",
    "opencode",
    "ai",
    "coding-agent",
    "cli",
    "mcp",
    "monaco",
    "terminal",
    "whisper"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win zip && node scripts/build-setup.js",
    "setup": "node scripts/build-setup.js",
    "zip:source": "node scripts/zip-source.js"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@huggingface/transformers": "^4.3.1",
    "@lydell/node-pty": "^1.2.0-beta.15",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.17",
    "marked": "^18.1.1",
    "monaco-editor": "^0.57.0"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.hyperide.ide",
    "productName": "hyper-ide",
    "copyright": "Copyright (c) 2026 hyper-ide contributors",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "asar": true,
    "files": [
      "src/**/*",
      "package.json",
      "!**/*.map",
      "!**/*.pdb",
      "!node_modules/**/*.md",
      "!node_modules/**/*.markdown",
      "!node_modules/**/*.d.ts",
      "!node_modules/**/{test,tests,__tests__,docs,example,examples,.github}/**",
      "!node_modules/monaco-editor/{esm,dev,min-maps}/**",
      "!node_modules/onnxruntime-web/**",
      "!node_modules/onnxruntime-node/script/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/{darwin,linux}/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/win32/arm64/**"
    ],
    "asarUnpack": [
      "src/voice/**",
      "src/pc/**",
      "node_modules/@lydell/**",
      "node_modules/@huggingface/**",
      "node_modules/onnxruntime-node/**",
      "node_modules/onnxruntime-common/**",
      "node_modules/sharp/**",
      "node_modules/@img/**",
      "node_modules/detect-libc/**",
      "node_modules/semver/**"
    ],
    "forceCodeSigning": false,
    "win": {
      "icon": "src/renderer/assets/icon.ico",
      "target": [
        { "target": "zip", "arch": ["x64"] }
      ],
      "signAndEditExecutable": true,
      "artifactName": "hyper-${version}-portable.${ext}"
    }

  }
}
