{
  "id": "hello-world",
  "name": "Hello World",
  "version": "1.0.0",
  "description": "The smallest useful plugin: a palette command, a keyboard shortcut and a status bar item.",
  "author": "Reva",
  "icon": "sparkle",
  "main": "index.js",
  "reva": ">=0.3.0",
  "activation": ["onStartup"],
  "permissions": [],
  "contributes": {
    "commands": [
      { "id": "sayHello", "title": "Hello World: Say Hello", "keybinding": "Ctrl+Alt+H" }
    ],
    "statusBar": [
      { "id": "hello", "align": "left", "text": "Hello" }
    ]
  }
}
